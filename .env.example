# Development defaults. Production must provide PostgreSQL, shared Redis limits,
# and an IMAGE_STORAGE_FACTORY implementation.
APP_ENV=development
FLASK_SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=sqlite:///uas.db
UNIVERSITY_TIMEZONE=Asia/Kuala_Lumpur
# Development only. Production lecturer accounts use one-time invitations.
LECTURER_REGISTRATION_SECRET=replace-with-a-rotated-private-secret
SESSION_COOKIE_SECURE=0
FLASK_DEBUG=0
RATELIMIT_STORAGE_URI=memory://
REQUIRE_EMAIL_VERIFICATION=0

# Production example. Replace values in the deployment secret/config store.
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://user:password@db-host/uas
# RATELIMIT_STORAGE_URI=rediss://redis-host:6379/0
# IMAGE_STORAGE_FACTORY=your_package.storage:create_image_storage
# MAIL_DELIVERY_FACTORY=your_package.mail:create_sender
# REQUIRE_EMAIL_VERIFICATION=1
# TRUSTED_HOSTS=uas.example.edu
# ProxyFix trusts only the explicitly configured number of proxy hops per header.
# Set each count to the actual trusted proxy count; leave at 0 otherwise.
# PROXY_FIX_X_FOR=1
# PROXY_FIX_X_PROTO=1
# PROXY_FIX_X_HOST=0
# PROXY_FIX_X_PORT=0
# PROXY_FIX_X_PREFIX=0
# ALLOW_PRODUCTION_SQLITE=1  # Only for an intentional single-instance deployment.

# Set only for the one-time `flask --app app bootstrap-admin` command.
# ADMIN_EMAIL=admin@example.edu
# ADMIN_PASSWORD=replace-with-a-long-unique-password
