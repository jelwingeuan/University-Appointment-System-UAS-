# Copy to .env and replace every placeholder before running outside tests.
APP_ENV=development
FLASK_SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=sqlite:///uas.db
UNIVERSITY_TIMEZONE=Asia/Kuala_Lumpur
LECTURER_REGISTRATION_SECRET=replace-with-a-rotated-private-secret
SESSION_COOKIE_SECURE=0
FLASK_DEBUG=0
RATELIMIT_STORAGE_URI=memory://

# Set only for the one-time `flask --app app bootstrap-admin` command.
# ADMIN_EMAIL=admin@example.edu
# ADMIN_PASSWORD=replace-with-a-long-unique-password
